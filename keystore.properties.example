# Copy this file to keystore.properties and point it at your signing keystore.
# Both keystore.properties and keystore/ are gitignored: the signing key must
# never reach a public repository, because anyone holding it can build an APK
# that Android will accept as a legitimate update to this package.
#
# Without this file the build still works and falls back to the debug key. That
# is fine for a first install, but a debug-signed APK will not install over an
# existing copy signed with a different key — you would have to uninstall first.
#
# To create a keystore:
#
#   keytool -genkeypair -v -keystore keystore/slate.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias slate \
#     -dname "CN=Slate Sideload, OU=Personal, O=Slate, C=US"
#
# Keep a backup of the .jks file somewhere outside the repository. If you lose
# it you can still build, but never again as an update to the installed app.

storeFile=keystore/slate.jks
storePassword=CHANGE_ME
keyAlias=slate
keyPassword=CHANGE_ME
