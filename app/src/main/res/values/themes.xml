<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flat white, no shadows, no ripples, no animation. Everything an E Ink
         panel cannot render is switched off here rather than fought at runtime. -->
    <style name="SlateTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@android:color/black</item>
        <item name="android:colorControlActivated">@android:color/black</item>
        <item name="android:colorControlHighlight">#20000000</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorHighlight">#33000000</item>
    </style>
</resources>
